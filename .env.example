# ACMCL Voting Portal — Environment Configuration Example (Brevo SMTP)
#
# ASP.NET Core does NOT auto-load .env files.
# Copy this file to .env and load it into your PowerShell session before migrating or running:
#   Copy-Item .env.example .env
#   . .\scripts\import-dotenv.ps1
#
# Existing process environment variables take precedence by default.
# After editing .env in the same shell, reload with:
#   . .\scripts\import-dotenv.ps1 -Overwrite
#
# Never commit .env or put real credentials or invitation codes in git.

# Hosting environment (Development or Production)
ASPNETCORE_ENVIRONMENT=Development

# Optional SQL Server connection string override.
# Leave commented out to use ConnectionStrings:VotingDb in appsettings.json
# (Server=localhost;Database=ACMCLVoting;Integrated Security=True;TrustServerCertificate=True).
# Uncomment and adjust if using SQL Server Express or custom credentials:
# ConnectionStrings__VotingDb=Server=.\SQLEXPRESS;Database=ACMCLVoting;Integrated Security=True;TrustServerCertificate=True

# Optional one-time bootstrap code for registering the very first administrator account.
# Leave blank if an administrator already exists or if you configure it with dotnet user-secrets.
AdminAccount__InvitationCode=

# ---------------------------------------------------------------------------
# Brevo SMTP Configuration (Required for live verification & password recovery emails)
# ---------------------------------------------------------------------------
# Official setup references:
# - https://help.brevo.com/hc/en-us/articles/7924908994450-Send-transactional-emails-using-Brevo-SMTP
# - https://help.brevo.com/hc/en-us/articles/7959631848850-Create-and-manage-your-SMTP-keys
# - https://help.brevo.com/hc/en-us/articles/10905415650322-Which-SMTP-port-should-I-use-Port-587-465-or-2525

# Brevo SMTP relay host and port (port 587 uses STARTTLS via System.Net.Mail.SmtpClient)
Email__SmtpHost=smtp-relay.brevo.com
Email__SmtpPort=587
Email__UseSsl=true

# Enter the SMTP Login shown in Brevo -> SMTP & API -> SMTP (e.g., your Brevo SMTP login identifier).
Email__SmtpUsername=

# Enter a generated Brevo SMTP key from Brevo -> SMTP & API -> SMTP -> Generate a new SMTP key.
# Do NOT use your Brevo account password or a REST API key.
Email__SmtpPassword=

# Enter a real sender email address verified in Brevo -> Senders, Domains & Dedicated IPs
# (or on an authenticated domain). Do NOT substitute your @smtp-brevo.com SMTP Login here.
Email__FromAddress=
Email__FromName=ACMCL Vote

# ---------------------------------------------------------------------------
# Local Test Sink (Development / automated tests ONLY)
# ---------------------------------------------------------------------------
# Keep Email__PickupDirectory empty for normal Brevo SMTP delivery.
# To save .eml files locally instead of sending live mail during Development tests:
#   1. Clear Email__SmtpHost=
#   2. Set Email__PickupDirectory=App_Data/dev-emails
Email__PickupDirectory=

# Optional private storage path for candidate photographs (defaults to App_Data/candidate-photos).
CandidatePhotos__StoragePath=
