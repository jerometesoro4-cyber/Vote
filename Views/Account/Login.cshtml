@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
@if (TempData["Success"] is string success)
{
    <div class="form-notice success" role="status">@success</div>
}
@if (TempData["Error"] is string tempError)
{
    <div class="form-alert" role="alert">@tempError</div>
}
@if (ViewBag.Error != null)
{
    <div class="form-alert" role="alert">@ViewBag.Error</div>
}
<form asp-action="Login" method="post" class="auth-form">
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <div class="form-field">
        <label for="email">Email address</label>
        <input id="email" name="email" value="@ViewBag.Email" type="email" autocomplete="username" spellcheck="false" maxlength="254" enterkeyhint="next" required />
    </div>
    <div class="form-field">
        <label for="password">Password</label>
        <div class="password-field">
            <input id="password" name="password" type="password" autocomplete="current-password" maxlength="256" enterkeyhint="done" required />
            <button type="button" class="password-toggle" data-password-toggle aria-controls="password" aria-pressed="false" aria-label="Show password">Show</button>
        </div>
    </div>
    <button type="submit" class="auth-button">Sign in</button>
</form>
<div class="auth-footer">
    <p><a asp-action="ForgotPassword" asp-route-returnUrl="@ViewBag.ReturnUrl">Forgot password?</a></p>
    <p><a asp-action="Register">Create an account</a></p>
</div>
