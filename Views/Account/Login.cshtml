@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}
<p class="form-kicker">ACMCL VOTING PORTAL</p>
<h1>Sign in</h1>
<p class="form-intro">Enter your account details to continue.</p>
@if (ViewBag.Error != null)
{
    <div class="form-alert" role="alert">@ViewBag.Error</div>
}
<form asp-action="Login" method="post" class="auth-form">
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <div class="form-field">
        <label for="email">Email address</label>
        <input id="email" name="email" value="@ViewBag.Email" type="email" autocomplete="username" maxlength="254" required />
    </div>
    <div class="form-field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" maxlength="256" required />
    </div>
    <button type="submit" class="auth-button">Sign in</button>
</form>
<div class="auth-footer">
    <p>New here? <a asp-action="Register">Create an account</a></p>
</div>
