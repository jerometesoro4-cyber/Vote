@model voting.Models.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset password";
}
<h1>Reset password</h1>
<p class="form-intro">Enter the 6-digit recovery code from your email and choose a new password.</p>
@if (TempData["Success"] is string success)
{
    <div class="form-notice success" role="status">@success</div>
}
@if (TempData["Error"] is string tempError)
{
    <div class="form-alert" role="alert">@tempError</div>
}
<div asp-validation-summary="ModelOnly" class="form-alert" role="alert"></div>
<form asp-action="ResetPassword" method="post" class="auth-form">
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="form-field">
        <label asp-for="Email">Email address</label>
        <input asp-for="Email" type="email" autocomplete="username" spellcheck="false" required />
        <span asp-validation-for="Email"></span>
    </div>
    <div class="form-field">
        <label asp-for="Code">Recovery code</label>
        <p id="reset-code-hint" class="field-hint">Enter the 6-digit code sent to your email address.</p>
        <input asp-for="Code" type="text" class="otp-input" inputmode="numeric" autocomplete="one-time-code" pattern="\d{6}" maxlength="6" aria-describedby="reset-code-hint" required />
        <span asp-validation-for="Code"></span>
    </div>
    <div class="form-field">
        <label asp-for="Password">New password</label>
        <div class="password-field">
            <input asp-for="Password" autocomplete="new-password" aria-describedby="reset-password-hint" />
            <button type="button" class="password-toggle" data-password-toggle aria-controls="Password" aria-pressed="false" aria-label="Show new password">Show</button>
        </div>
        <small id="reset-password-hint">Use 12 to 256 characters.</small>
        <span asp-validation-for="Password"></span>
    </div>
    <div class="form-field">
        <label asp-for="ConfirmPassword">Confirm new password</label>
        <div class="password-field">
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <button type="button" class="password-toggle" data-password-toggle aria-controls="ConfirmPassword" aria-pressed="false" aria-label="Show confirm password">Show</button>
        </div>
        <span asp-validation-for="ConfirmPassword"></span>
    </div>
    <button type="submit" class="auth-button">Reset password</button>
</form>
<form asp-action="ForgotPassword" method="post" class="auth-resend-form">
    <input type="hidden" name="email" value="@Model.Email" />
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <input type="hidden" name="stayOnReset" value="true" />
    <button type="submit" class="auth-secondary-btn">Resend recovery code</button>
</form>
<div class="auth-footer">
    <p><a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Back to sign in</a></p>
</div>
