@{
    Layout = null;
    ViewData["Title"] = "Choose Account Type";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Choose Account Type - ACMCL</title>
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>
<body>
    <main class="role-container">
        <img src="~/images/logo.webp" alt="ACMCL Logo" class="logo" />
        <div class="school-name">ACMCL COLLEGE INC.</div>
        <h1>Choose your account type</h1>
        <p class="subtitle">Select how you want to continue.</p>

        <div class="role-options">
            <section class="role-card">
                <h2>Student</h2>
                <p>Sign in or create a student account to access the voting portal.</p>
                <a class="login-btn" asp-action="StudentLogin">Student sign in</a>
                <a class="secondary-btn" asp-action="StudentSignup">Create a student account</a>
            </section>

            <section class="role-card">
                <h2>Administrator</h2>
                <p>Sign in or register with an administrator invitation code.</p>
                <a class="login-btn" asp-action="AdminLogin">Administrator sign in</a>
                <a class="secondary-btn" asp-action="AdminSignup">Administrator sign up</a>
            </section>
        </div>

        <div class="footer">© 2026 ACMCL College Inc.</div>
    </main>
</body>
</html>
