@model voting.Models.StudentRegistrationViewModel
@{
    Layout = null;
    ViewData["Title"] = "Student Sign Up";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Sign Up - ACMCL</title>
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>
<body>
    <main class="login-container">
        <img src="~/images/logo.webp" alt="ACMCL Logo" class="logo" />
        <div class="school-name">ACMCL COLLEGE INC.</div>
        <h2>Create a student account</h2>
        <p class="subtitle">Use your school email address.</p>

        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        <form asp-action="StudentSignup" method="post">
            @Html.AntiForgeryToken()

            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" />
            <span asp-validation-for="Email" class="field-validation-error"></span>

            <div class="mb-3">
    <label asp-for="FullName" class="form-label"></label>
    <input asp-for="FullName" class="form-control" />
    <span asp-validation-for="FullName" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="YearLevel" class="form-label"></label>
    <input asp-for="YearLevel" class="form-control" placeholder="e.g. 3rd Year" />
    <span asp-validation-for="YearLevel" class="text-danger"></span>
</div>

            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-validation-error"></span>

            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>

            <button type="submit" class="login-btn">Create student account</button>
        </form>

        <div class="auth-links">
            <a asp-action="StudentLogin">Already registered? Sign in</a>
            <br />
            <a asp-action="ChooseRole">Choose another account type</a>
        </div>
    </main>
</body>
</html>
