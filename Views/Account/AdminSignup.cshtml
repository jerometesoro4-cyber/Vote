@model voting.Models.AdminRegistrationViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Administrator registration";
}
<p class="form-kicker">ADMINISTRATOR REGISTRATION</p>
<h1>Create an admin account</h1>
<p class="form-intro">You need an administrator invitation code to register.</p>
<div asp-validation-summary="ModelOnly" class="form-alert" role="alert"></div>
<form asp-action="AdminSignup" method="post" class="auth-form">
    <div class="form-field"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName"></span></div>
    <div class="form-field"><label asp-for="Email">Email address</label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div>
    <div class="form-field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" aria-describedby="password-hint" /><small id="password-hint">Use 12 to 256 characters.</small><span asp-validation-for="Password"></span></div>
    <div class="form-field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
    <div class="form-field"><label asp-for="InvitationCode"></label><input asp-for="InvitationCode" autocomplete="off" /><span asp-validation-for="InvitationCode"></span></div>
    <button type="submit" class="auth-button">Create admin account</button>
</form>
<p class="auth-links">Already registered? <a asp-action="Login">Sign in</a></p>
