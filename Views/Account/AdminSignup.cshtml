@model voting.Models.AdminRegistrationViewModel
@{
    Layout = null;
    ViewData["Title"] = "Administrator Sign Up";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Administrator Sign Up - ACMCL</title>
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>
<body>
    <main class="login-container">
        <img src="~/images/logo.webp" alt="ACMCL Logo" class="logo" />
        <div class="school-name">ACMCL COLLEGE INC.</div>
        <h2>Create an administrator account</h2>
        <p class="subtitle">An administrator invitation code is required.</p>

        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        <form asp-action="AdminSignup" method="post">
            @Html.AntiForgeryToken()

            <label asp-for="FullName"></label>
            <input asp-for="FullName" autocomplete="name" />
            <span asp-validation-for="FullName" class="field-validation-error"></span>

            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" />
            <span asp-validation-for="Email" class="field-validation-error"></span>

            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-validation-error"></span>

            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>

            <label asp-for="InvitationCode"></label>
            <input asp-for="InvitationCode" autocomplete="off" />
            <span asp-validation-for="InvitationCode" class="field-validation-error"></span>

            <button type="submit" class="login-btn">Create administrator account</button>
        </form>

        <div class="auth-links">
            <a asp-action="AdminLogin">Already registered? Sign in</a>
            <br />
            <a asp-action="ChooseRole">Choose another account type</a>
        </div>
    </main>
</body>
</html>
