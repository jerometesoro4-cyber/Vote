@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}
<h1>Forgot password</h1>
<p class="form-intro">Enter your registered email address and we will send a 6-digit recovery code if an account matches.</p>
@if (TempData["Success"] is string success)
{
    <div class="form-notice success" role="status">@success</div>
}
@if (TempData["Error"] is string tempError)
{
    <div class="form-alert" role="alert">@tempError</div>
}
@if (ViewBag.Error != null)
{
    <div class="form-alert" role="alert">@ViewBag.Error</div>
}
<form asp-action="ForgotPassword" method="post" class="auth-form">
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <div class="form-field">
        <label for="email">Email address</label>
        <input id="email" name="email" value="@ViewBag.Email" type="email" autocomplete="email" spellcheck="false" maxlength="254" required />
    </div>
    <button type="submit" class="auth-button">Send recovery code</button>
</form>
<div class="auth-footer">
    <p><a asp-action="ResetPassword" asp-route-email="@ViewBag.Email" asp-route-returnUrl="@ViewBag.ReturnUrl">Already have a recovery code?</a></p>
    <p><a asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl">Back to sign in</a></p>
</div>
