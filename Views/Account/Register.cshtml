@model voting.Models.RegistrationViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create an account";
}
<h1>Create an account</h1>
<div asp-validation-summary="ModelOnly" class="form-alert" role="alert"></div>
<form asp-action="Register" method="post" class="auth-form">
    <div class="form-field"><label asp-for="Role"></label><select asp-for="Role"><option value="Student">Student</option><option value="Admin">Administrator</option></select><span asp-validation-for="Role"></span></div>
    <div class="form-field"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName"></span></div>
    <div class="form-field"><label asp-for="Email">Email address</label><input asp-for="Email" type="email" autocomplete="email" spellcheck="false" /><span asp-validation-for="Email"></span></div>
    <div class="form-field" id="student-fields"><label asp-for="YearLevel">Year level <span class="optional">(optional)</span></label><input asp-for="YearLevel" autocomplete="off" placeholder="e.g. 3rd year" /><span asp-validation-for="YearLevel"></span></div>
    <div class="form-field">
        <label asp-for="Password"></label>
        <div class="password-field">
            <input asp-for="Password" autocomplete="new-password" aria-describedby="password-hint" />
            <button type="button" class="password-toggle" data-password-toggle aria-controls="Password" aria-pressed="false" aria-label="Show password">Show</button>
        </div>
        <small id="password-hint">Use 12 to 256 characters.</small>
        <span asp-validation-for="Password"></span>
    </div>
    <div class="form-field">
        <label asp-for="ConfirmPassword"></label>
        <div class="password-field">
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <button type="button" class="password-toggle" data-password-toggle aria-controls="ConfirmPassword" aria-pressed="false" aria-label="Show confirm password">Show</button>
        </div>
        <span asp-validation-for="ConfirmPassword"></span>
    </div>
    <div class="form-field" id="admin-fields">
        <label asp-for="InvitationCode"></label>
        <div class="password-field">
            <input asp-for="InvitationCode" autocomplete="off" />
            <button type="button" class="password-toggle" data-password-toggle aria-controls="InvitationCode" aria-pressed="false" aria-label="Show invitation code">Show</button>
        </div>
        <small>Required for administrator accounts.</small>
        <span asp-validation-for="InvitationCode"></span>
    </div>
    <button type="submit" class="auth-button">Create account</button>
</form>
<p class="auth-links">Already registered? <a asp-action="Login">Sign in</a></p>
<script>
    const role = document.getElementById('Role');
    function updateRoleFields() {
        for (const [id, accountType] of [['student-fields', 'Student'], ['admin-fields', 'Admin']]) {
            const field = document.getElementById(id);
            field.hidden = role.value !== accountType;
            for (const control of field.querySelectorAll('input, button')) {
                control.disabled = field.hidden;
            }
        }
        document.getElementById('InvitationCode').required = role.value === 'Admin';
    }
    role.addEventListener('change', updateRoleFields);
    updateRoleFields();
</script>
