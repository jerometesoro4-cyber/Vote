@model voting.Models.PaginationModel
@if (Model.TotalItems > 0)
{
    var startItem = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var endItem = Math.Min(Model.TotalItems, Model.CurrentPage * Model.PageSize);
    string PageUrl(int targetPage) => Url.Action(Model.Action, "Admin", new
    {
        id = Model.Id,
        q = string.IsNullOrWhiteSpace(Model.Q) ? null : Model.Q,
        status = string.IsNullOrWhiteSpace(Model.Status) ? null : Model.Status,
        group = string.IsNullOrWhiteSpace(Model.Group) ? null : Model.Group,
        positionId = Model.PositionId,
        page = targetPage > 1 ? targetPage : (int?)null
    }) ?? "#";

    <nav class="pagination" aria-label="Pagination">
        <span class="pagination-summary">Showing @startItem–@endItem of @Model.TotalItems (Page @Model.CurrentPage of @Model.TotalPages)</span>
        @if (Model.TotalPages > 1)
        {
            <ul class="pagination-list" role="list">
                @if (Model.CurrentPage > 1)
                {
                    <li><a class="pagination-link" href="@PageUrl(Model.CurrentPage - 1)">Previous</a></li>
                }
                else
                {
                    <li><span class="pagination-link disabled" aria-disabled="true">Previous</span></li>
                }
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    if (p == 1 || p == Model.TotalPages || Math.Abs(p - Model.CurrentPage) <= 1)
                    {
                        <li>
                            <a class="pagination-link @(p == Model.CurrentPage ? "current" : null)"
                               href="@PageUrl(p)"
                               aria-current="@(p == Model.CurrentPage ? "page" : null)">@p</a>
                        </li>
                    }
                    else if (p == 2 && Model.CurrentPage > 3 || p == Model.TotalPages - 1 && Model.CurrentPage < Model.TotalPages - 2)
                    {
                        <li><span class="pagination-ellipsis" aria-hidden="true">…</span></li>
                    }
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li><a class="pagination-link" href="@PageUrl(Model.CurrentPage + 1)">Next</a></li>
                }
                else
                {
                    <li><span class="pagination-link disabled" aria-disabled="true">Next</span></li>
                }
            </ul>
        }
    </nav>
}
