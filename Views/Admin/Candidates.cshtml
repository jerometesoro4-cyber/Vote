@model voting.Models.DashboardViewModel
@{ViewData["Title"]="Candidates";}<div class="page-heading">
<div>
<h1>Candidates</h1>
<p>Build the ballot before opening an election.</p>
</div>
</div>
<section class="panel">
<h2>Add candidate</h2>
<form asp-action="AddCandidate" method="post">
<div class="form-grid">
<div class="field">
<label for="position">Position · draft election</label>
<select name="positionId" id="position" required>
<option value="">Choose position</option>@foreach(var p in Model.Positions.Where(p=>p.Election.Status=="Draft")){<option value="@p.Id">@p.Election.Name · @p.Name</option>}</select>
</div>
<div class="field">
<label for="name">Full name</label>
<input id="name" name="name" maxlength="100" required/>
</div>
<div class="field">
<label for="party">Party / affiliation</label>
<input id="party" name="party" maxlength="100"/>
</div>
<div class="field">
<label for="platform">Platform</label>
<textarea id="platform" name="platform" maxlength="2000">
</textarea>
</div>
</div>
<div class="form-actions">
<button type="submit">Add candidate</button>
</div>
</form>
</section>
<partial name="_CandidateCards" model="Model"/>