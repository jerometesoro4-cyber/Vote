@model voting.Models.DashboardViewModel
@{ViewData["Title"]="Positions";}<div class="page-heading">
<div>
<h1>Positions</h1>
<p>Define the offices students will vote for in each election.</p>
</div>
</div>
<section class="panel">
<h2>Add position</h2>
<form asp-action="AddPosition" method="post">
<div class="form-grid">
<div class="field">
<label for="election">Draft election</label>
<select id="election" name="electionId" required>
<option value="">Choose election</option>@foreach(var e in Model.Elections.Where(e=>e.Status=="Draft")){<option value="@e.Id">@e.Name</option>}</select>
</div>
<div class="field">
<label for="position">Position name</label>
<input id="position" name="name" required maxlength="100" placeholder="e.g. President"/>
</div>
</div>
<div class="form-actions">
<button type="submit">Add position</button>
</div>
</form>
</section>
<section class="panel">
<h2>Election positions</h2>@if(Model.Positions.Count==0){<div class="empty">No positions yet.</div>}@foreach(var p in Model.Positions){<div class="activity">
<p>
<strong>@p.Name</strong>
<small>@p.Election.Name · @p.Candidates.Count candidates</small>
</p>
</div>}</section>