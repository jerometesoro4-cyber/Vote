@model IReadOnlyList<(string Label, string Url)>
<nav class="breadcrumb" aria-label="Breadcrumbs">
    <ol>
        @for (var i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            var isLast = i == Model.Count - 1;
            <li>
                <a href="@item.Url" aria-current="@(isLast ? "page" : null)">@item.Label</a>
            </li>
        }
    </ol>
</nav>
