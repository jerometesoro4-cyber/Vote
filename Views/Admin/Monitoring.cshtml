@{
    ViewData["Title"] = "Voting Monitoring";
}

<div class="page-heading">
    <h1>Voting Monitoring</h1>
    <p>Monitor student voting activity.</p>
</div>

<div class="dashboard-container">

    <div class="info-card">
        <h3>Eligible Voters</h3>
        <h1>320</h1>
    </div>

    <div class="info-card">
        <h3>Votes Submitted</h3>
        <h1>0</h1>
    </div>

    <div class="info-card">
        <h3>Remaining Voters</h3>
        <h1>320</h1>
    </div>

</div>

<div class="content-card">

    <h2>Voter Turnout Report</h2>

    <p>Voting activity will appear here.</p>

    <h2>Voter Records</h2>

    <table>
        <thead>
            <tr>
                <th>Student ID</th>
                <th>Student Name</th>
                <th>Voting Status</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td colspan="3">No voting records available.</td>
            </tr>
        </tbody>
    </table>

</div>