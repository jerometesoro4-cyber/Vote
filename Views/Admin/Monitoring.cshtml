@model voting.Models.DashboardViewModel
@{ViewData["Title"]="Monitoring";}<div class="page-heading">
<div>
<h1>Voting monitoring</h1>
<p>Ballot counts by election. Refresh this page for the latest totals.</p>
</div>
</div>
<section class="panel">
<h2>@Model.BallotCount ballots submitted</h2>@foreach(var e in Model.Elections){<div class="activity">
<span class="activity-icon">✓</span>
<p>
<strong>@e.Name</strong>
<small>@Model.Ballots.Count(b=>b.ElectionId==e.Id) submitted ballots · @e.Status</small>
</p>
</div>}</section>