@model voting.Models.DashboardViewModel
@{
    ViewData["Title"] = "Elections";
    var election = Model.SelectedElection;
    var now = DateTime.UtcNow;
}

<div class="page-heading">
    <div>
        <h1>@(election?.Name ?? "Elections")</h1>
        @if (election != null)
        {
            <p>@election.StartsAtManila.ToString("MMM d, yyyy h:mm tt") to @election.EndsAtManila.ToString("MMM d, yyyy h:mm tt") PHT</p>
        }
    </div>
    @if (election != null)
    {
        <a class="button secondary" asp-action="Elections" asp-route-id="">All elections</a>
    }
    else
    {
        <a class="button secondary" href="#create-election">Create election</a>
    }
</div>

@if (election == null)
{
    <partial name="_ElectionList" model="Model"/>
    <section id="create-election" class="panel election-create" tabindex="-1">
        <h2>Create election</h2>
        <form asp-action="CreateElection" method="post">
            <div class="field">
                <label for="name">Election name</label>
                <input id="name" name="name" required maxlength="150" placeholder="e.g. Room 101 Election"/>
            </div>
            <partial name="_ScheduleFields" model="Model"/>
            <p>
                <label><input type="checkbox" name="includeStandardPositions" value="true" checked aria-describedby="standard-positions"/> Add standard positions</label>
                <input type="hidden" name="includeStandardPositions" value="false"/>
                <br/><small id="standard-positions">@string.Join(", ", Election.StandardPositions)</small>
            </p>
            <button type="submit">Create draft election</button>
        </form>
    </section>
}
else
{
    <section class="panel">
        <div class="panel-head">
            <h2>Ballot setup</h2>
            <span class="badge @(election.IsVotingOpenAt(now) ? "open" : "")">@election.VotingStatusAt(now)</span>
        </div>
        <div class="quick-links">
            <a asp-action="Positions" asp-route-id="@election.Id">Positions (@election.Positions.Count)</a>
            <a asp-action="Candidates" asp-route-id="@election.Id">Candidates (@election.Positions.Sum(p => p.Candidates.Count))</a>
        </div>
        @if (election.Status == "Draft" && election.EndsAtUtc <= now)
        {
            <p>The voting period has ended. <a href="#edit-schedule">Set a future end time</a> to open voting.</p>
        }
        else if (election.Status == "Draft" && !election.HasCompleteBallot())
        {
            <p>Add at least one position and one candidate per position to open voting.</p>
        }
        else if (election.Status is "Draft" or "Open")
        {
            <form class="form-actions" asp-action="ChangeStatus" method="post">
                <input type="hidden" name="id" value="@election.Id"/>
                <input type="hidden" name="status" value="@(election.Status == "Draft" ? "Open" : "Closed")"/>
                <button type="submit">@(election.Status == "Draft" ? "Open voting" : "Close voting")</button>
            </form>
        }
    </section>
    @if ((election.Status is "Draft" or "Open") && !Model.Ballots.Any(b => b.ElectionId == election.Id))
    {
        <section class="panel" id="edit-schedule">
            <h2>Edit schedule</h2>
            <form asp-action="UpdateSchedule" method="post">
                <input type="hidden" name="id" value="@election.Id"/>
                <partial name="_ScheduleFields" model="Model"/>
                <button class="form-actions" type="submit">Save schedule</button>
            </form>
        </section>
    }
}
