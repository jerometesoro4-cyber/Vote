@{
    ViewData["Title"] = "Election Guidelines";
}

<div class="page-heading">
    <h1>Election Guidelines & Rules</h1>
    <p>Please read the following guidelines.</p>
</div>

<div class="content-card">

    <h2>Election Rules</h2>

    <ol>
        <li>Only eligible students may participate.</li>

        <li>Students must use their verified school accounts.</li>

        <li>Each student can vote only once per election.</li>

        <li>Review the candidates before voting.</li>

        <li>Keep your account credentials confidential.</li>

        <li>Follow the official election schedule.</li>

        <li>Respect the election process and its results.</li>
    </ol>

</div>