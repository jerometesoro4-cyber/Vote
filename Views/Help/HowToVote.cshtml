@{
    ViewData["Title"] = "How to Vote";
}

<div class="page-heading">
    <h1>How to Vote</h1>
    <p>Student voting guide.</p>
</div>

<div class="content-card">

    <h2>Voting Instructions</h2>

    <ol>

        <li>
            <strong>Scan the QR Code</strong>
            <p>Scan the official election QR code.</p>
        </li>

        <li>
            <strong>Student Login</strong>
            <p>Sign in using your verified school account.</p>
        </li>

        <li>
            <strong>Check Election Status</strong>
            <p>Make sure the election is currently active.</p>
        </li>

        <li>
            <strong>View Candidates</strong>
            <p>Review candidate information and platforms.</p>
        </li>

        <li>
            <strong>Review Your Ballot</strong>
            <p>Check your selections before submitting.</p>
        </li>

        <li>
            <strong>Submit Your Vote</strong>
            <p>Submit your ballot once.</p>
        </li>

        <li>
            <strong>Confirmation</strong>
            <p>Wait for your voting confirmation.</p>
        </li>

    </ol>

</div>