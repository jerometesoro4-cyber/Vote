@{
    ViewData["Title"] = "How to Vote";
}

<div class="page-heading">
    <h1>How to Vote</h1>
</div>

<div class="content-card">

    <h2>Voting Instructions</h2>

    <ol>

        <li>
            <strong>Sign in</strong>
            <p>Use your student account to <a asp-controller="Student" asp-action="ActiveElections">open Elections</a>.</p>
        </li>

        <li>
            <strong>Choose your election</strong>
            <p>Select the row for your election when it shows <strong>Start voting</strong>.</p>
        </li>

        <li>
            <strong>Choose your candidates</strong>
            <p>The ballot tells you how many candidates to select for each position. Use <strong>Read profile</strong> to see a candidate's platform.</p>
        </li>

        <li>
            <strong>Submit your ballot</strong>
            <p>Select <strong>Review ballot</strong> and check the names before selecting <strong>Submit final ballot</strong>.</p>
        </li>

        <li>
            <strong>Confirmation</strong>
            <p>My ballots shows your submitted election and the submission time.</p>
        </li>

    </ol>

</div>
