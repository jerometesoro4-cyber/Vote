@{
    ViewData["Title"] = "How to Vote";
}

<div class="page-heading">
    <h1>How to Vote</h1>
    <p>Student voting guide.</p>
</div>

<div class="content-card">

    <h2>Voting Instructions</h2>

    <ol>

        <li>
            <strong>Sign in</strong>
            <p>Use your student account to <a asp-controller="Student" asp-action="ActiveElections">open Elections</a>.</p>
        </li>

        <li>
            <strong>Choose your election</strong>
            <p>Click the name of your room's election. You can cast a ballot when its status is Voting open.</p>
        </li>

        <li>
            <strong>View Candidates</strong>
            <p>Select Review candidates to see who is running in that election.</p>
        </li>

        <li>
            <strong>Review Your Ballot</strong>
            <p>Choose one candidate per position and review your selections.</p>
        </li>

        <li>
            <strong>Submit Your Vote</strong>
            <p>Select Submit final ballot.</p>
        </li>

        <li>
            <strong>Confirmation</strong>
            <p>My ballots shows your submitted election and the submission time.</p>
        </li>

    </ol>

</div>
