@model voting.Models.DashboardViewModel
@{
    ViewData["Title"] = "Candidates";
    var election = Model.SelectedElection;
}

<div class="page-heading">
    <div>
        <h1>@(election == null ? "Candidates" : $"{election.Name} candidates")</h1>
    </div>
    @if (election != null)
    {
        <a class="button secondary" asp-action="Candidates" asp-route-id="">All open elections</a>
    }
</div>

@if (election == null)
{
    <partial name="_ElectionList" model="Model"/>
}
else
{
    <partial name="_CandidateCards" model="election.Positions.SelectMany(p => p.Candidates).ToList()"/>
    <a class="button" asp-action="Vote" asp-route-id="@election.Id">@(Model.Ballots.Any(b => b.ElectionId == election.Id) ? "View ballot status" : "Start voting")</a>
}
