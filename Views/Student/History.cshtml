@model voting.Models.DashboardViewModel
@{ViewData["Title"]="My ballots";}<div class="page-heading">
<div>
<h1>My ballots</h1>
<p>Your successful submissions. Ballot choices are not displayed here.</p>
</div>
</div>
<section class="panel">@if(Model.Ballots.Count==0){<div class="empty">
<strong>You haven’t submitted a ballot yet</strong>Explore available elections to get started.</div>}@foreach(var b in Model.Ballots.OrderByDescending(b=>b.CastAtUtc)){<div class="activity">
<span class="activity-icon">✓</span>
<p>
<strong>@b.Election.Name</strong>
<small>Submitted @b.CastAtUtc.ToString("MMM d, yyyy HH:mm") UTC</small>
</p>
</div>}</section>