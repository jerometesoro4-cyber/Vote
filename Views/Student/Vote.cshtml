@model voting.Models.DashboardViewModel
@{ViewData["Title"]="Your ballot";var election=Model.SelectedElection;}<div class="page-heading">
<div>
<p class="eyebrow">STUDENT BALLOT</p>
<h1>@election?.Name</h1>
<p>Select one candidate for each position. Submission is final.</p>
</div>
</div>@if(election!=null){<section class="panel">
<form asp-action="Vote" method="post">
<input type="hidden" name="electionId" value="@election.Id"/>@foreach(var p in Model.Positions.Where(p=>p.ElectionId==election.Id)){<fieldset class="ballot-position">
<legend>@p.Name</legend>@foreach(var c in Model.Candidates.Where(c=>c.PositionId==p.Id)){<label class="ballot-choice">
<input type="radio" name="choices[@p.Id]" value="@c.Id" required/>
<span>
<strong>@c.Name</strong>
<br/>
<small>@c.Party · @c.Platform</small>
</span>
</label>}</fieldset>}<div class="notice">Review your choices carefully. You cannot change your ballot after submission.</div>
<button type="submit">Submit final ballot</button>
</form>
</section>}
