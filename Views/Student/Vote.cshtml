@model voting.Models.DashboardViewModel
@{
    var election = Model.SelectedElection!;
    ViewData["Title"] = election.Name;
    var now = DateTime.UtcNow;
    var submitted = Model.Ballots.Any(ballot => ballot.ElectionId == election.Id);
    var canVote = !submitted && election.IsVotingOpenAt(now) && election.HasCompleteBallot();
}

<div class="ballot-page">
    <a class="back-link" asp-action="ActiveElections"><span aria-hidden="true">←</span> Elections</a>
    <div class="page-heading">
        <div>
            <h1 id="election-heading">@election.Name</h1>
            @if (canVote)
            {
                <p>Closes @election.EndsAtManila.ToString("MMM d, yyyy h:mm tt") PHT</p>
            }
        </div>
        @if (canVote)
        {
            <a class="text-link" asp-action="Candidates" asp-route-id="@election.Id">Candidate profiles</a>
        }
    </div>
    @if (submitted)
    {
        <div class="panel">
            <h2>Ballot submitted</h2>
            <a class="text-link" asp-action="History">My ballots</a>
        </div>
    }
    else if (election.Status == "Closed")
    {
        <div class="panel">
            <h2>Voting closed</h2>
            <a class="text-link" asp-action="Results">View results</a>
        </div>
    }
    else if (now < election.StartsAtUtc)
    {
        <div class="panel">
            <h2>Scheduled</h2>
            <p>Opens @election.StartsAtManila.ToString("MMM d, yyyy h:mm tt") PHT</p>
        </div>
    }
    else if (!election.IsVotingOpenAt(now))
    {
        <p class="list-empty">Voting ended.</p>
    }
    else if (!election.HasCompleteBallot())
    {
        <p class="list-empty">Ballot unavailable.</p>
    }
    else
    {
        <form asp-action="Vote" method="post" class="ballot-form" aria-labelledby="election-heading">
            <input type="hidden" name="electionId" value="@election.Id"/>
            @foreach (var position in election.Positions.OrderBy(p => p.Id))
            {
                <fieldset class="ballot-position">
                    <legend>@position.Name</legend>
                    <div class="ballot-options">
                        @foreach (var candidate in position.Candidates.OrderBy(c => c.Id))
                        {
                            <label class="ballot-choice" for="candidate-@candidate.Id">
                                <input id="candidate-@candidate.Id" type="radio" name="choices[@position.Id]" value="@candidate.Id" required/>
                                <span>
                                    <strong>@candidate.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(candidate.Party))
                                    {
                                        <small class="candidate-party">@candidate.Party</small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(candidate.Platform))
                                    {
                                        <small class="candidate-platform">@candidate.Platform</small>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                </fieldset>
            }
            <div class="ballot-actions">
                <button type="submit">Submit final ballot</button>
            </div>
        </form>
    }
</div>
