@model voting.Models.DashboardViewModel
@{
    var election = Model.SelectedElection!;
    ViewData["Title"] = election.Name;
    var now = DateTime.UtcNow;
    var submitted = Model.Ballots.Any(ballot => ballot.ElectionId == election.Id);
    var canVote = !submitted && election.IsVotingOpenAt(now) && election.HasCompleteBallot();
}

<div class="ballot-page">
    <a class="back-link" asp-action="ActiveElections"><span aria-hidden="true">←</span> Elections</a>
    <div class="page-heading">
        <div>
            <h1 id="election-heading">@election.Name</h1>
            @if (canVote)
            {
                <p>Closes @election.EndsAtManila.ToString("MMM d, yyyy h:mm tt") PHT</p>
            }
        </div>
    </div>
    @if (submitted)
    {
        <div class="panel">
            <h2>Ballot submitted</h2>
            <a class="text-link" asp-action="History">My ballots</a>
        </div>
    }
    else if (election.Status == "Closed")
    {
        <div class="panel">
            <h2>Voting closed</h2>
            <a class="text-link" asp-action="Results">View results</a>
        </div>
    }
    else if (now < election.StartsAtUtc)
    {
        <div class="panel">
            <h2>Scheduled</h2>
            <p>Opens @election.StartsAtManila.ToString("MMM d, yyyy h:mm tt") PHT</p>
        </div>
    }
    else if (!election.IsVotingOpenAt(now))
    {
        <p class="list-empty">Voting ended.</p>
    }
    else if (!election.HasCompleteBallot())
    {
        <p class="list-empty">Ballot unavailable.</p>
    }
    else if (Model.BallotReviewToken is { } reviewToken)
    {
        <section class="panel ballot-review" aria-labelledby="review-heading">
            <h2 id="review-heading">Review your ballot</h2>
            <dl>
                @foreach (var position in election.Positions.OrderBy(p => p.Id))
                {
                    <div class="review-choice">
                        <dt>@position.Name</dt>
                        <dd>@string.Join(", ", position.Candidates.Where(c => Model.SelectedCandidateIds.Contains(c.Id)).OrderBy(c => c.Id).Select(c => c.Name))</dd>
                    </div>
                }
            </dl>
            <form asp-action="Vote" method="post" class="ballot-actions">
                <input type="hidden" name="electionId" value="@election.Id"/>
                <input type="hidden" name="reviewToken" value="@reviewToken"/>
                <button class="button secondary" type="submit" name="step" value="Edit">Edit choices</button>
                <button type="submit" name="step" value="Confirm">Submit final ballot</button>
            </form>
        </section>
    }
    else
    {
        <form asp-action="Vote" method="post" class="ballot-form" aria-labelledby="election-heading">
            <input type="hidden" name="electionId" value="@election.Id"/>
            @foreach (var position in election.Positions.OrderBy(p => p.Id))
            {
                var maximum = position.AvailableMaxSelections;
                var multiple = maximum > 1;
                <fieldset class="ballot-position" aria-describedby="rule-@position.Id"
                          data-min-selections="@position.MinSelections" data-max-selections="@maximum">
                    <legend>@position.Name</legend>
                    <p class="ballot-instruction" id="rule-@position.Id">Select @position.DescribeSelections(maximum).</p>
                    <div class="ballot-options">
                        @foreach (var candidate in position.Candidates.OrderBy(c => c.Id))
                        {
                            var hasProfile = !string.IsNullOrWhiteSpace(candidate.Platform);
                            <div class="ballot-option @(hasProfile ? "has-profile" : null)">
                                <label class="ballot-choice" for="candidate-@candidate.Id">
                                    <input id="candidate-@candidate.Id" type="@(multiple ? "checkbox" : "radio")" name="choices[@position.Id]"
                                           value="@candidate.Id" required="@(!multiple)" checked="@Model.SelectedCandidateIds.Contains(candidate.Id)"/>
                                    @if (candidate.HasPhoto)
                                    {
                                        <img class="ballot-photo" src="@Url.Action("CandidatePhoto", "PublicPortal", new { id = candidate.Id })" alt="" loading="lazy" />
                                    }
                                    <span>
                                        <strong>@candidate.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(candidate.Party))
                                        {
                                            <small class="candidate-party">@candidate.Party</small>
                                        }
                                    </span>
                                </label>
                                @if (hasProfile)
                                {
                                    <details class="ballot-profile">
                                        <summary aria-label="Read profile for @candidate.Name">Read profile</summary>
                                        <p>@candidate.Platform</p>
                                    </details>
                                }
                            </div>
                        }
                    </div>
                </fieldset>
            }
            <div class="ballot-actions">
                <button type="submit">Review ballot</button>
            </div>
        </form>
    }
</div>
