<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | ACMCL Voting</title>
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to sign in</a>
    <div class="auth-shell">
        <header class="auth-brand">
            <a asp-controller="Home" asp-action="Index" class="brand-name"><img src="~/images/logo.webp" alt="" width="36" height="36"/> <span>ACMCL <strong>Vote</strong></span></a>
        </header>
        <main class="auth-main" id="main-content">
            <div class="auth-content">@RenderBody()</div>
        </main>
    </div>
</body>
</html>
