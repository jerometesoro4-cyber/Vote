@{
    var admin = User.IsInRole("Admin");
    var member = User.Identity?.IsAuthenticated == true;
    var area = admin ? "Admin" : "Student";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var current = ViewContext.RouteData.Values["action"]?.ToString();
    var electionId = (ViewData.Model as DashboardViewModel)?.SelectedElection?.Id;
    var items = admin
        ? new[] { ("Index","Overview","layout-dashboard"), ("Elections","Elections","calendar-days"), ("Positions","Positions","list-ordered"), ("Candidates","Candidates","users"), ("Users","Voters","users"), ("Monitoring","Monitoring","activity"), ("Results","Results","chart-column"), ("Settings","Account","settings") }
        : new[] { ("ActiveElections","Elections","calendar-days"), ("Candidates","Candidates","users"), ("History","My ballots","check-check"), ("Results","Results","chart-column") };
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content="#10392a"/>
<title>@ViewData["Title"] · ACMCL Vote</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="app-shell">
<aside class="app-sidebar">
<a class="app-brand" asp-controller="@(member ? area : "Home")" asp-action="Index">
<img src="~/images/logo.webp" alt="" width="36" height="36"/>
<span>ACMCL <strong>Vote</strong></span>
</a>
<nav aria-label="Primary">
<ul>
@if(member) { foreach(var item in items) {
var routeId = admin && item.Item1 is ("Elections" or "Positions" or "Candidates") ? electionId : null;
var active = controller == area && current == item.Item1;
var inElections = controller == "Student" && current is ("Index" or "Vote") && item.Item1 == "ActiveElections";
<li>
<a asp-controller="@area" asp-action="@item.Item1" asp-route-id="@(routeId?.ToString() ?? "")" aria-current="@(active ? "page" : inElections ? "location" : null)">
<svg class="nav-icon" aria-hidden="true" width="20" height="20"><use href="/images/icons.svg#@item.Item3"></use></svg>@item.Item2</a>
</li> } }
else { <li>
<a asp-controller="Account" asp-action="Login">Sign in</a>
</li>
<li>
<a asp-controller="PublicPortal" asp-action="Candidates">Candidates</a>
</li>
<li>
<a asp-controller="PublicPortal" asp-action="Results">Results</a>
</li> }
</ul>
</nav>
</aside>
<div class="workspace">
@if (member)
{
    <header class="workspace-header">
        <span class="account-name">@User.Identity?.Name</span>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button class="text-button" type="submit">Sign out</button>
        </form>
    </header>
}
<main id="main" class="page-main" tabindex="-1">
@if(TempData["Error"] is string error){<div class="notice error" role="alert">@error</div>}
@if(TempData["Success"] is string success){<div class="notice success" role="status">@success</div>}
@RenderBody()</main>
<footer>
    <span>© 2026 ACMCL College Inc.</span>
    <nav aria-label="Help">
        <a asp-controller="Help" asp-action="HowToVote">Voting guide</a>
        <a asp-controller="Help" asp-action="Privacy">Privacy</a>
        <a asp-controller="Help" asp-action="Terms">Terms &amp; conditions</a>
    </nav>
</footer>
</div>
</div>
<script src="~/js/site.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required:false)</body>
</html>
