@{
    var admin = User.IsInRole("Admin");
    var member = User.Identity?.IsAuthenticated == true;
    var area = admin ? "Admin" : "Student";
    var current = ViewContext.RouteData.Values["action"]?.ToString();
    var items = admin ? new[] { ("Index","Overview","layout-dashboard"), ("Elections","Elections","calendar-days"), ("Positions","Positions","list-ordered"), ("Candidates","Candidates","users"), ("Users","Voters","users"), ("Monitoring","Monitoring","activity"), ("Results","Results","chart-column"), ("Settings","Account","settings") } : new[] { ("Index","Overview","layout-dashboard"), ("ActiveElections","Elections","calendar-days"), ("Candidates","Candidates","users"), ("History","My ballots","check-check"), ("Results","Results","chart-column") };
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>@ViewData["Title"] · ACMCL Vote</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="app-shell">
<aside class="app-sidebar">
<a class="app-brand" asp-controller="Home" asp-action="Index">
<img src="~/images/logo.webp" alt="" width="44" height="44"/>
<span>ACMCL <strong>Vote</strong>
<small>COLLEGE ELECTION PORTAL</small>
</span>
</a>
<p class="nav-label">@(admin ? "ADMINISTRATION" : member ? "STUDENT PORTAL" : "ELECTION PORTAL")</p>
<nav aria-label="Primary">
<ul>
@if(member) { foreach(var item in items) { <li>
<a asp-controller="@area" asp-action="@item.Item1" aria-current="@(current == item.Item1 && ViewContext.RouteData.Values["controller"]?.ToString() == area ? "page" : null)">
<svg class="nav-icon" aria-hidden="true" width="20" height="20"><use href="/images/icons.svg#@item.Item3"></use></svg>@item.Item2</a>
</li> } }
else { <li>
<a asp-controller="Account" asp-action="Login">Sign in</a>
</li>
<li>
<a asp-controller="PublicPortal" asp-action="Candidates">Candidates</a>
</li>
<li>
<a asp-controller="PublicPortal" asp-action="Results">Results</a>
</li> }
</ul>
</nav>
<div class="sidebar-bottom">
<a asp-controller="Help" asp-action="HowToVote">Voting guide ↗</a>
<a asp-controller="Help" asp-action="Privacy">Privacy policy ↗</a>
<p>ACMCL College Inc.<br/>Every voice matters.</p>
</div>
</aside>
<div class="workspace">
<header class="workspace-header">
<span class="breadcrumb">Workspace <span>/</span> @ViewData["Title"]</span>
<div class="account-chip">
<span class="avatar" aria-hidden="true">@(member ? User.Identity?.Name?.Substring(0, 1).ToUpperInvariant() : "G")</span>
<span>@(member ? User.Identity?.Name : "Guest")<small>@(admin ? "Administrator" : member ? "Student" : "Public access")</small>
</span>@if(member){<form asp-controller="Account" asp-action="Logout" method="post">
<button class="text-button" type="submit">Sign out</button>
</form>}</div>
</header>
<main id="main" class="page-main">
@if(TempData["Error"] is string error){<div class="notice error" role="alert">@error</div>}
@if(TempData["Success"] is string success){<div class="notice success" role="status">@success</div>}
@RenderBody()</main>
<footer>© 2026 ACMCL College Inc. <span>Automated Voting &amp; Tally System</span>
</footer>
</div>
</div>
@await RenderSectionAsync("Scripts", required:false)</body>
</html>