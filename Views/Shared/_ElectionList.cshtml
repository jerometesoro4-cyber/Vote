@model voting.Models.DashboardViewModel
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var destination = (controller, action) switch
    {
        ("Admin", "Positions" or "Candidates") => action,
        ("Admin", _) => "Elections",
        ("Student", "Candidates") => "Candidates",
        ("Student", _) => "Vote",
        _ => null
    };
    var now = DateTime.UtcNow;
    var submitted = Model.Ballots.Select(ballot => ballot.ElectionId).ToHashSet();
    var sourceElections = Model.PagedElections ?? Model.Elections;
    var isFilteredAdminList = controller == "Admin" && action == "Elections" && Model.PagedElections != null;
    var rows = sourceElections.Select(election => new
    {
        Election = election,
        Submitted = controller == "Student" && submitted.Contains(election.Id),
        CanVote = destination == "Vote" && !submitted.Contains(election.Id)
            && election.IsVotingOpenAt(now) && election.HasCompleteBallot()
    });
    if (!isFilteredAdminList)
    {
        rows = rows.OrderByDescending(row => row.CanVote).ThenByDescending(row => row.Election.Id);
    }
}

@if (sourceElections.Count == 0)
{
    if (isFilteredAdminList && (!string.IsNullOrWhiteSpace(Model.SearchQuery) || !string.IsNullOrWhiteSpace(Model.StatusFilter) || !string.IsNullOrWhiteSpace(Model.GroupFilter)))
    {
        <div class="empty">
            <strong>No matching elections</strong>
            <p>No elections match the current search or filters.</p>
            <a class="button secondary" asp-controller="Admin" asp-action="Elections">Reset filters</a>
        </div>
    }
    else
    {
        <p class="list-empty">@(controller == "Student" && action == "Candidates" ? "No open elections." : "No elections yet.")</p>
    }
}
else
{
    <ul class="election-list" role="list" aria-label="Elections">
        @foreach (var row in rows)
        {
            var election = row.Election;
            var href = destination is null
                ? null
                : (controller == "Admin" && action == "Elections"
                    ? Url.Action(destination, controller, new
                    {
                        id = election.Id,
                        q = string.IsNullOrWhiteSpace(Model.SearchQuery) ? null : Model.SearchQuery,
                        status = string.IsNullOrWhiteSpace(Model.StatusFilter) ? null : Model.StatusFilter,
                        group = string.IsNullOrWhiteSpace(Model.GroupFilter) ? null : Model.GroupFilter,
                        page = Model.CurrentPage > 1 ? Model.CurrentPage : (int?)null
                    })
                    : Url.Action(destination, controller, new { id = election.Id }));
            var start = election.StartsAtManila.ToString("MMM d, h:mm tt");
            var end = election.EndsAtManila.ToString("MMM d, yyyy h:mm tt");
            var period = (destination, row.CanVote, row.Submitted) switch
            {
                ("Vote", _, true) => null,
                ("Vote", true, _) => $"Closes {end} PHT",
                ("Vote", _, _) when now < election.StartsAtUtc && election.Status == "Open" => $"Opens {start} PHT",
                _ => $"{start} – {end} PHT"
            };
            var label = (controller, destination, row.CanVote, row.Submitted) switch
            {
                ("Student", "Candidates", _, _) => "View candidates",
                (_, "Vote", true, _) => "Start voting",
                (_, "Vote", _, true) => "Ballot submitted",
                (_, "Vote", _, _) when election.IsVotingOpenAt(now) => "Ballot unavailable",
                _ => election.VotingStatusAt(now)
            };
            var state = row.CanVote ? "available" : row.Submitted ? "submitted" : label == "Scheduled" ? "scheduled" : null;
            <li>
                <a class="election-row @state" href="@href">
                    <span class="election-info">
                        @if (row.CanVote)
                        {
                            <span class="election-availability">Voting open</span>
                        }
                        <strong class="election-name">@election.Name</strong>
                        @if (period != null)
                        {
                            <span class="election-period">@period</span>
                        }
                        @if (controller == "Admin" && !string.IsNullOrWhiteSpace(election.RequiredGroup))
                        {
                            <span class="election-period"> · Group: @election.RequiredGroup</span>
                        }
                    </span>
                    <span class="election-action @(row.CanVote ? "can-vote" : null)">
                        @label
                        @if (href != null)
                        {
                            <span aria-hidden="true">→</span>
                        }
                    </span>
                </a>
            </li>
        }
    </ul>
}
