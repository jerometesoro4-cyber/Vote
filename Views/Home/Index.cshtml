@{ViewData["Title"]="Welcome";}<section class="welcome"><p class="eyebrow">ACMCL COLLEGE INC.</p><h1>Your voice.<br/>Your campus. Your future.</h1><p>The student election workspace. Explore candidates, find your election, and cast your ballot.</p>@if(User.Identity?.IsAuthenticated==true){<a class="button" asp-controller="@(User.IsInRole("Admin")?"Admin":"Student")" asp-action="Index">Go to your dashboard →</a>}else{<a class="button" asp-controller="Account" asp-action="ChooseRole">Get started →</a>}</section><div class="dashboard-container"><section class="panel"><h2>Explore the candidates</h2><p>Read platforms and get to know your potential representatives.</p><a asp-controller="PublicPortal" asp-action="Candidates">Meet candidates →</a></section><section class="panel"><h2>Find your voting period</h2><p>Check election dates and availability before you vote.</p><a asp-controller="PublicPortal" asp-action="Schedule">Election schedule →</a></section><section class="panel"><h2>See published results</h2><p>Review candidate tallies once an election closes.</p><a asp-controller="PublicPortal" asp-action="Results">View results →</a></section></div>